{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd ../.. && npm ci",
  "buildCommand": "cd ../.. && npm run build -w @erp/shared && npm run build -w web",
  "outputDirectory": "dist/web/browser",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://smart-erp-api-gamma.vercel.app/api/:path*" },
    { "source": "/(.*)", "destination": "/index.csr.html" }
  ]
}
