NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/smart-erp?replicaSet=rs0&directConnection=true
CLIENT_URL=http://localhost:4200
LOG_LEVEL=debug

# Auth
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=604800
BCRYPT_ROUNDS=12

# Optional: set if mongodb+srv fails with "querySrv ECONNREFUSED"
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Proxies in front of the API (1 = one load balancer; 2 = Vercel rewrite → Render)
TRUST_PROXY=1
